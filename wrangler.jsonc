{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valorandomizer",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "META_BETA_LOGIN_LIMITER",
      "namespace_id": "21001",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "META_BETA_CHAT_LIMITER",
      "namespace_id": "21002",
      "simple": {
        "limit": 4,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
  // Secrets required for the private beta:
  //   wrangler secret put META_BETA_PASSWORD
  //   wrangler secret put META_BETA_AUTH_SECRET
  //
  // Phase 2: add a D1 binding here, e.g.
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "valorandomizer", "database_id": "<id>" }
  // ]
}
