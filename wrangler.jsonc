{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valorandomizer",
  "main": "custom-worker.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "DISCORD_PUBLIC_KEY": "8ce8db912030ffaa557cd860487c472bcf94ced82b65f83f647a155f4cef0f9e",
    "DISCORD_ALLOWED_GUILD_ID": "1148945042510196806"
  },
  "triggers": {
    "crons": ["17 * * * *", "0 19 * * *"]
  },
  "ratelimits": [
    {
      "name": "META_BETA_LOGIN_LIMITER",
      "namespace_id": "21001",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "META_BETA_CHAT_LIMITER",
      "namespace_id": "21002",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
