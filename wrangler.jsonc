{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valorandomizer",
  "main": "custom-worker.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "RIOT_RSO_COLLECTION_ENABLED": "false"
  },
  "triggers": {
    "crons": ["17 * * * *", "0 19 * * *"]
  },
  "ratelimits": [
    {
      "name": "META_BETA_LOGIN_LIMITER",
      "namespace_id": "21001",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "META_BETA_CHAT_LIMITER",
      "namespace_id": "21002",
      "simple": {
        "limit": 4,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
  // Secrets required for the private beta:
  //   wrangler secret put META_BETA_PASSWORD
  //   wrangler secret put META_BETA_AUTH_SECRET
  //   wrangler secret put RIOT_API_KEY
  //
  // Only after Riot approves the Production application and RSO flow:
  //   1. add RIOT_VAL_BASE_URL to vars using the approved routing host;
  //   2. change RIOT_RSO_COLLECTION_ENABLED to "true";
  //   3. register only RSO-opted-in accounts.
  //
  // After creating the D1 database, add its generated UUID here and remove
  // the comment markers. The SQL files under migrations/ can then be applied
  // with: wrangler d1 migrations apply valorandomizer --remote
  //
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "valorandomizer",
  //     "database_id": "<generated-d1-database-id>",
  //     "migrations_dir": "migrations"
  //   }
  // ]
}
